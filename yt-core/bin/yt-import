#!/usr/bin/env python3
"""Merge a yt-export archive into this machine's local layer (~/yt-local/).

Usage:
  yt-import <file> [--dry-run]

  --dry-run   show what would be added or updated; change nothing

Merging, not replacing: settings from the archive add to or update the same key
(routes by task kind, vaults by name), blocked-list lines and record lines are
added once, and local entries the archive does not mention stay. config.json
"repo" is never taken from the archive. Each file that changes is backed up to
~/yt-local/backups/import-<time>/ first. The archive is rejected as a whole if it
holds anything but the expected files or fails its checksums.
Run yt-setup (once per machine) and yt-doctor afterwards.
Exit codes: 0 imported (or nothing to do), 1 error.
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))
from ytlib import transfer  # noqa: E402


def main(argv):
    if not argv or "-h" in argv or "--help" in argv:
        print(__doc__)
        return 0 if argv else 1
    dry = "--dry-run" in argv
    rest = [a for a in argv if a != "--dry-run"]
    if len(rest) != 1:
        print(__doc__, file=sys.stderr)
        return 1
    try:
        changes = transfer.plan(transfer.read_archive(rest[0]))
    except (OSError, ValueError, UnicodeDecodeError) as e:
        print(f"yt-import: {e}", file=sys.stderr)
        return 1
    for name, action, _ in changes:
        print(f"[{action:>6}] {name}")
    if dry:
        print("yt-import: dry run, nothing changed")
        return 0
    try:
        backup = transfer.apply(changes)
    except OSError as e:
        print(f"yt-import: {e}", file=sys.stderr)
        return 1
    if backup:
        print(f"yt-import: previous files backed up to {backup}")
    for w in transfer.warnings():
        print(f"[  note] {w}")
    print("yt-import: done; run yt-setup if this machine is new, then yt-doctor")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
