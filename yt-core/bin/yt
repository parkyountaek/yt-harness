#!/usr/bin/env python3
"""Supervise sub-sessions.

Usage:
  yt panel [--no-doctor]                   what needs you, what runs, harness health, retire hints
  yt panel --json                          tasks and counts as JSON (no doctor run), for the Claude mods
  yt watch [--interval N] [--once] [--no-notify]
                                           live task view in any terminal; a desktop notice when a
                                           task needs you (told once, shared with the work-alerts mod)
  yt status                                list tasks: id, harness, runtime, state, alive, deadline
  yt attach <task-id>                      hand this terminal to the sub-session (type directly)
  yt stop <task-id>                        stop the sub-session; the task can be resumed later
  yt resume <task-id> [--deadline 30m]     restart a stopped sub-session; the deadline restarts
                                           from now (default: the harness deadline)
  yt forget <task-id>                      drop a stopped or finished task from the session list
  yt route [<task-kind>]                   show the task-kind -> harness routes (~/yt-local/routes.json)
  yt collect <task-id>                     check the result against the contract and print it
  yt bring <task-id>                       worktree task: fetch branch yt/<task-id> into the source
                                           repository as a new branch (never merges or overwrites)
  yt answer <task-id> "<text>"             type the human's answer into a waiting-human session
  yt metrics [--days N]                    per harness and runtime: tasks, success rate, tokens, turns
  yt model [<harness>]                     the model and effort chosen per harness and runtime in this
                                           workspace (the project you run in); with a harness: its
                                           workload and the models available here
  yt model <harness> <claude|codex> <model> [<effort>]
                                           save the choice for this workspace; the default from then on
                                           (run it again to change it; <model> reset forgets it)
  yt harness list                          harnesses: version, on/off, Codex copy, routes
  yt harness on|off <name>                 allow or refuse new sub-sessions of a harness
  yt harness new <name> "<purpose>"        scaffold a new (experimental) harness from the template
  yt harness candidates                    task kinds with no route that came up twice or more
  yt eval <task-id> pass|fail [--judge human|model|deterministic] [--fixed]
                                           record a verdict (enumerations only, no notes)
  yt improve <harness>                     compare versions: success, tokens, turns
  yt improve <harness> --propose [--runtime claude|codex] [--runner R]
                                           a yt-improve sub-session proposes a change to the
                                           harness's skills on branch yt/<task>; never applied
  yt card <task-id>                        case card: the task's shape without its content

The task folder and deadline come from the coordinator's session list, never from
status.json (the session can write that file). `yt status` marks a task stale when
its deadline passed and it is not done or failed, and failed when it reported done
without out/result.md or left an unreadable status.json.
Exit codes: 0 ok, 1 error, 2 concurrency limit reached,
            3 not finished yet (collect), 4 the task failed (collect).
"""
import json
import subprocess
import os
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))
from ytlib import core  # noqa: E402
from ytlib import gitwork  # noqa: E402
from ytlib import launch  # noqa: E402
from ytlib import lab  # noqa: E402
from ytlib import metrics  # noqa: E402
from ytlib import parity  # noqa: E402
from ytlib import runners  # noqa: E402


def fail(msg, code=1):
    print(f"yt: {msg}", file=sys.stderr)
    return code


def judge(task_id, entry):
    """Coordinator-side transitions, applied to the freshest status under the task lock."""
    task_dir = core.task_dir(task_id)
    if not os.path.isdir(os.path.join(task_dir, "out")):
        return {"state": "missing"}
    deadline = core.safe_deadline(entry.get("deadline"))

    def change(status):
        state = status.get("state")
        if not status:
            return False
        if state not in core.STATES:
            status.update(state="failed", reason="status.json is unreadable or has an unknown state")
        elif state == "done" and not os.path.isfile(core.result_path(task_dir)):
            status.update(state="failed", reason="reported done but out/result.md is missing")
        elif state not in core.FINAL + ("stale",) and deadline and core.now() > deadline:
            status.update(state="stale", staleSince=core.iso(core.now()), staleFrom=state)
        else:
            return False
        core.log_event("state", taskId=task_id, state=status["state"], by="yt")

    try:
        return core.update_status(task_dir, change)
    except TimeoutError:
        return {"state": "busy", "reason": "status lock held by the session"}


def cmd_status():
    reg = core.load_sessions()
    rows = []
    for task_id, e in sorted(reg["sessions"].items()):
        status = judge(task_id, e)
        alive = bool(e.get("runnerHandle")) and runners.load(e["runner"]).alive(e["runnerHandle"])
        note = str(status.get("question") or status.get("reason") or "")[:80]
        if not alive and status.get("state") == "running" and e.get("runnerHandle"):
            note = note or "run ended without reporting; check `yt attach`, then `yt resume`"
        rows.append((task_id, f"{e['harness']} {status.get('harnessVersion', '')}".strip(), e["runtime"],
                     status.get("state", "?"), "yes" if alive else "no", e.get("deadline", ""), note))
    if not rows:
        print("no tasks")
        return 0
    head = ("TASK", "HARNESS", "RUNTIME", "STATE", "ALIVE", "DEADLINE", "NOTE")
    widths = [max(len(str(r[i])) for r in rows + [head]) for i in range(len(head))]
    for r in [head] + rows:
        print("  ".join(str(v).ljust(w) for v, w in zip(r, widths)).rstrip())
    if any(r[3] == "stale" for r in rows):
        print("\nStale tasks passed their deadline. Decide: `yt attach <id>` to check, or `yt stop <id>`.")
    return 0


def entry_and_runner(task_id):
    e = core.load_sessions()["sessions"].get(task_id)
    if not e:
        raise KeyError(task_id)
    return e, runners.load(e["runner"])


def is_alive(e, runner):
    return bool(e.get("runnerHandle")) and runner.alive(e["runnerHandle"])


def settled(e, wait=30):
    """True once the session's process is gone. A headless run can take a few seconds to exit
    after it reported done, so wait for it; an interactive session stays until `yt stop`."""
    runner = runners.load(e["runner"])
    end = time.time() + (wait if not getattr(runner, "INTERACTIVE", True) else 0)
    while is_alive(e, runner):
        if time.time() >= end:
            return False
        time.sleep(1)
    return True


def cmd_attach(task_id):
    e, runner = entry_and_runner(task_id)
    if not getattr(runner, "INTERACTIVE", True) and e.get("runnerHandle"):
        core.log_event("attach", taskId=task_id)
        return runner.attach(e["runnerHandle"])   # headless: show (and follow) the output log
    if not is_alive(e, runner):
        return fail(f"{task_id} is not running; use `yt resume {task_id}`")
    core.log_event("attach", taskId=task_id)
    return runner.attach(e["runnerHandle"])


def cmd_stop(task_id):
    e, runner = entry_and_runner(task_id)
    rc = runner.stop(e["runnerHandle"]) if e.get("runnerHandle") else 0
    core.log_event("stop", taskId=task_id, ok=rc == 0)
    print(f"yt: {task_id} stopped" if rc == 0 else f"yt: {task_id} did not stop cleanly")
    return rc


def cmd_resume(task_id, deadline_arg=None, answer=None):
    """Restart a stopped session. With answer: the next headless run, carrying the human's answer."""
    task_dir = core.task_dir(task_id)
    drift = parity.problems()
    if drift:
        return fail("Claude and Codex global setup differ: " + "; ".join(drift))
    with core.locked(core.REGISTRY_LOCK):
        reg = core.load_sessions()
        e = reg["sessions"].get(task_id)
        if not e:
            raise KeyError(task_id)
        runner = runners.load(e["runner"])
        if is_alive(e, runner) or e.get("starting"):
            return fail(f"{task_id} is still running; stop it first")
        status = core.read_status(task_dir) or {}
        if status.get("state") in core.FINAL:
            return fail(f"{task_id} is already {status['state']}")
        if answer is not None and status.get("state") != "waiting-human":
            return fail(f"{task_id} is {status.get('state')}, not waiting-human")
        busy = sum(1 for other_id, o in reg["sessions"].items()
                   if other_id != task_id and (o.get("starting") or is_alive(o, runners.load(o["runner"]))))
        if busy >= core.MAX_CONCURRENT:
            return fail(f"{busy} sub-sessions running; the limit is {core.MAX_CONCURRENT}", 2)
        harness = core.load_harness(e["harness"])
        sid = e.get("runtimeSessionId")
        if not sid and e["runtime"] == "codex":
            sid = launch.find_codex_session(os.path.join(task_dir, "out"), since=0, timeout=1, scan=500)
        if not sid:
            return fail(f"{task_id} has no runtime session id; cannot resume")
        if e["runtime"] == "codex":
            problem = launch.codex_plugin_problem(e["harness"], harness.get("version"))
            if problem:
                return fail(problem)
        try:
            if answer is not None and core.safe_deadline(e.get("deadline")):
                deadline = core.safe_deadline(e["deadline"])   # answering does not extend the deadline
            else:
                deadline = core.parse_deadline(deadline_arg or harness.get("deadlineDefault") or "2h")
        except ValueError:
            return fail(f"bad deadline {deadline_arg!r}")
        e.update(starting=True, startedAt=core.iso(core.now()), runtimeSessionId=sid, deadline=core.iso(deadline))
        core.save_sessions(reg)

    error, handle = None, None
    try:
        handle, _ = launch.start(task_id, e["harness"], harness, e["runtime"], e["runner"], sid, resume=True,
                                 answer=answer, vault=e.get("vaultPath"), repo_source=e.get("repoSource"),
                                 repo_clone=e.get("repoClone"), model=e.get("model"), effort=e.get("effort"))
    except Exception as ex:  # noqa: BLE001
        error = str(ex) or ex.__class__.__name__

    with core.locked(core.REGISTRY_LOCK):
        reg = core.load_sessions()
        reg["sessions"][task_id].update(runnerHandle=handle, starting=False)
        core.save_sessions(reg)
    if error:
        return fail(f"resume failed: {error}")

    def change(status):
        # Only coordinator-owned fields; the session may already have written its own state.
        status.update(runnerHandle=handle, runtimeSessionId=sid, deadline=core.iso(deadline))
        if status.get("state") == "stale":
            status["state"] = status.pop("staleFrom", "running")
            status.pop("staleSince", None)

    core.update_status(task_dir, change)
    if answer is not None:
        core.log_event("answer", taskId=task_id, ok=True, chars=len(answer), runner=e["runner"])
        print(f"yt: answer passed to {task_id} (new {e['runner']} run)")
        return 0
    core.log_event("resume", taskId=task_id, runtime=e["runtime"])
    print(f"yt: {task_id} resumed ({e['runtime']}, handle {handle}, deadline {core.iso(deadline)})")
    return 0


def cmd_forget(task_id):
    with core.locked(core.REGISTRY_LOCK):
        reg = core.load_sessions()
        e = reg["sessions"].get(task_id)
        if not e:
            raise KeyError(task_id)
        if is_alive(e, runners.load(e["runner"])) or e.get("starting"):
            return fail(f"{task_id} is still running; stop it first")
        metrics.record(task_id, e, core.read_status(core.task_dir(task_id)) or {})
        reg["sessions"].pop(task_id)
        core.save_sessions(reg)
    core.log_event("forget", taskId=task_id)
    print(f"yt: {task_id} removed from the session list (task folder kept; empty out/ before reusing the id)")
    return 0


RESULT_LIMIT = 200_000  # bytes; a larger result.md is not a summary


def cmd_route(kind=None):
    routes = (core.read_json(os.path.join(core.LOCAL, "routes.json"), {}) or {}).get("routes", [])
    if kind:
        match = [r for r in routes if r.get("taskKind") == kind]
        if not match:
            lab.route_miss(kind)
            return fail(f"no route for {kind!r}; known: {', '.join(r.get('taskKind', '?') for r in routes) or 'none'}")
        routes = match
    for r in routes:
        print(f"{r.get('taskKind')}  ->  {r.get('harness')}  (folder {r.get('folderKind', 'neutral')}"
              + (f", repo {r['repo']}" if r.get("repo") else "") + ")")
    return 0 if routes else fail("no routes in ~/yt-local/routes.json")


def cmd_collect(task_id):
    """Contract check before the coordinator reports a result to the human."""
    e = core.load_sessions()["sessions"].get(task_id)
    if not e:
        raise KeyError(task_id)
    status = judge(task_id, e)
    state = status.get("state")
    if state in ("running", "waiting-human", "stale", "busy"):
        print(f"yt: {task_id} is {state}" + (f": {status.get('question')}" if status.get("question") else ""))
        return 3
    if state == "failed":
        metrics.record(task_id, e, status)
        print(f"yt: {task_id} failed: {status.get('reason', 'no reason given')}")
        return 4
    problems = []
    if state != "done":
        problems.append(f"state is {state!r}")
    if status.get("taskId") != task_id:
        problems.append(f"status.json taskId is {status.get('taskId')!r}")
    if status.get("harness") != e["harness"] or status.get("runtime") != e["runtime"]:
        problems.append("status.json harness/runtime differ from the session list")
    path = core.result_path(core.task_dir(task_id))
    size = os.path.getsize(path) if os.path.isfile(path) else -1
    if size <= 0:
        problems.append("out/result.md is missing or empty")
    elif size > RESULT_LIMIT:
        problems.append(f"out/result.md is {size} bytes (limit {RESULT_LIMIT})")
    if problems:
        print(f"yt: {task_id} does not meet the result contract: " + "; ".join(problems), file=sys.stderr)
        return 1
    core.log_event("collect", taskId=task_id, bytes=size)
    metrics.record(task_id, e, status)
    print(f"# {task_id} ({e['harness']} {status.get('harnessVersion', '')}, {e['runtime']}): done")
    print(f"# result: {path}")
    evals = lab.run_evals(core.load_harness(e["harness"]), core.harness_dir(e["harness"]), core.task_dir(task_id))
    if evals:
        verdict = lab.eval_verdict(evals)
        print("# evals: " + ", ".join(f"{name} {state}" for name, state in evals)
              + (f" -> recorded {verdict} (judge deterministic; yt eval overrides)" if verdict
                 else " -> nothing recorded (an eval errored)"))
        if verdict:
            lab.eval_record(task_id, e, status, verdict, judge="deterministic")
    if e.get("repoBranch") and not settled(e):
        print(f"# the session is still running: `yt stop {task_id}`, then collect again to see its branch")
    elif e.get("repoBranch"):
        try:
            lines = gitwork.summary(e)
            print("\n".join("# " + line for line in lines))
            if lines and ": 0 commit(s)" not in lines[0]:
                print(f"# bring it into {e['repoSource']} as a branch: yt bring {task_id}")
        except RuntimeError as ex:
            print(f"yt: {task_id}: {ex}", file=sys.stderr)
            return 1
    print()
    with open(path, encoding="utf-8", errors="replace") as f:
        print(f.read().rstrip())
    return 0


def cmd_bring(task_id):
    """Fetch a worktree task's branch into the source repository (never merges)."""
    e = core.load_sessions()["sessions"].get(task_id)
    if not e:
        raise KeyError(task_id)
    if not e.get("repoClone"):
        return fail(f"{task_id} did not work on a repository")
    if not settled(e):
        return fail(f"{task_id} is still running; `yt stop {task_id}` first, so its clone cannot change")
    try:
        branch = gitwork.bring(e)
    except RuntimeError as ex:
        return fail(str(ex))
    core.log_event("bring", taskId=task_id)
    print(f"yt: {e['repoSource']} now has branch {branch}; review and merge it yourself")
    return 0


def cmd_answer(task_id, text):
    e, runner = entry_and_runner(task_id)
    if not text.strip():
        return fail("empty answer")
    if not getattr(runner, "INTERACTIVE", True):
        if is_alive(e, runner):
            return fail(f"{task_id} is still running; answer once it is waiting-human")
        return cmd_resume(task_id, answer=text)
    if not is_alive(e, runner):
        return fail(f"{task_id} is not running; use `yt resume {task_id}` first")
    state = (core.read_status(core.task_dir(task_id)) or {}).get("state")
    if state != "waiting-human":
        return fail(f"{task_id} is {state}, not waiting-human; use `yt attach {task_id}` to talk to it")
    if not text.strip():
        return fail("empty answer")
    rc = runner.send(e["runnerHandle"], text)
    core.log_event("answer", taskId=task_id, ok=rc == 0, chars=len(text))  # never the text itself
    return 0 if rc == 0 else fail("could not type into the session")


def cmd_metrics(days=30):
    since = core.now() - __import__("datetime").timedelta(days=days)
    groups = {}
    for d in metrics._lines(metrics.METRICS) if os.path.exists(metrics.METRICS) else []:
        t = core.safe_deadline(d.get("at"))
        if t and t >= since:
            groups.setdefault((d["harness"], str(d.get("harnessVersion")), d["runtime"]), []).append(d)
    if not groups:
        print(f"no metrics in the last {days} days")
        return 0
    head = ("HARNESS", "VERSION", "RUNTIME", "TASKS", "SUCCESS", "AVG TOKENS", "AVG TURNS", "AVG TOOLS")
    rows = []
    for (h, v, rt), ds in sorted(groups.items()):
        n = len(ds)
        tokens = sum(sum(d["tokens"].values()) for d in ds) / n
        rows.append((h, v, rt, str(n), f"{100 * sum(d['success'] for d in ds) / n:.0f}%", f"{tokens:,.0f}",
                     f"{sum(d['turns'] for d in ds) / n:.1f}", f"{sum(d['toolCalls'] for d in ds) / n:.1f}"))
    widths = [max(len(r[i]) for r in rows + [head]) for i in range(len(head))]
    for r in [head] + rows:
        print("  ".join(v.ljust(w) for v, w in zip(r, widths)).rstrip())
    print(f"\nLast {days} days. A change counts as better only if success holds and tokens or turns drop.")
    return 0


def task_entry(task_id):
    """The session-list entry, or the last metrics line once the task was forgotten."""
    e = core.load_sessions()["sessions"].get(task_id)
    if e:
        return e, core.read_status(core.task_dir(task_id)) or {}
    for d in reversed(list(metrics._lines(metrics.METRICS)) if os.path.exists(metrics.METRICS) else []):
        if d.get("taskId") == task_id:
            return ({"harness": d["harness"], "runtime": d["runtime"], "runtimeSessionId": d.get("sessionId")},
                    {"harnessVersion": d.get("harnessVersion"), "state": d.get("state")})
    raise KeyError(task_id)


def cmd_eval(task_id, opts):
    verdict = opts[0] if opts else None
    judge = opts[opts.index("--judge") + 1] if "--judge" in opts[:-1] else "human"
    e, status = task_entry(task_id)
    try:
        line = lab.eval_record(task_id, e, status, verdict, judge, "--fixed" in opts)
    except ValueError as ex:
        return fail(str(ex))
    print(f"yt: {task_id} {line['verdict']} ({line['judge']}" + (", human fixed it" if line["humanFixed"] else "") + ")")
    return 0


def cmd_improve(harness):
    rows, verdict = lab.improve_report(harness)
    if not rows:
        print(f"no metrics for {harness} yet")
        return 0
    print("VERSION  TASKS  SUCCESS  AVG TOKENS  AVG TURNS")
    for r in rows:
        print(f"{r['version']:<8} {r['tasks']:<6} {r['success']:<8.0%} {r['tokens']:<11,.0f} {r['turns']:.1f}")
    print(f"\n{verdict or 'one version only; nothing to compare'}")
    print("Proposals and changes stay with the human; a regression in success always wins over savings.")
    return 0


def cmd_improve_propose(harness, args):
    """Start a yt-improve sub-session on a clone of this checkout; it can only propose."""
    if harness not in core.harness_names() or harness == lab.IMPROVER:
        return fail(f"no harness {harness!r} to improve")
    runtime, runner = "claude", None
    while args:
        flag = args.pop(0)
        if flag in ("--runtime", "--runner") and args:
            value = args.pop(0)
            runtime, runner = (value, runner) if flag == "--runtime" else (runtime, value)
        else:
            return fail(f"unknown option {flag}")
    task_id = f"improve-{harness}-{core.now().strftime('%Y%m%d%H%M%S')}"
    in_dir = os.path.join(core.task_dir(task_id), "in")
    os.makedirs(in_dir, exist_ok=True)
    with open(os.path.join(in_dir, "BRIEF.md"), "w", encoding="utf-8") as f:
        f.write(lab.improve_brief(harness))
    argv = [sys.executable, os.path.join(core.CORE, "bin", "yt-spawn"), task_id, lab.IMPROVER,
            "--repo", gitwork.SELF, "--experimental", "--runtime", runtime]
    argv += ["--runner", runner] if runner else []
    for s in lab.improve_scope(harness):
        argv += ["--scope", s]
    return subprocess.call(argv)


def cmd_card(task_id):
    e, status = task_entry(task_id)
    print(json.dumps(lab.case_card(task_id, e, status), indent=2, ensure_ascii=False))
    print("Check it before it leaves this machine: counts and kinds only, no names, values, or text.",
          file=sys.stderr)
    return 0


def cmd_model(rest):
    if len(rest) >= 3:
        harness, runtime, model, effort = rest[0], rest[1], rest[2], (rest[3] if len(rest) > 3 else None)
        if harness not in core.harness_names() or runtime not in ("claude", "codex"):
            return fail(f"unknown harness or runtime: {harness} {runtime}")
        if model == "reset":
            launch.save_model(harness, runtime, None)
            print(f"yt: {harness} on {runtime} in {launch.workspace()}: choice forgotten (runtime default)")
            return 0
        try:
            launch.save_model(harness, runtime, model, effort)
        except ValueError as ex:
            return fail(str(ex))
        print(f"yt: {harness} on {runtime} in {launch.workspace()} now uses {model}"
              + (f", effort {effort}" if effort else ""))
        return 0
    names = rest or core.harness_names()
    if rest and rest[0] not in core.harness_names():
        return fail(f"unknown harness {rest[0]}")
    saved = launch.saved_models()
    print(f"workspace: {launch.workspace()}")
    for name in names:
        choice = saved.get(name, {})
        shown = "  ".join(f"{rt}: " + (f"{c['model']}/{c.get('effort', 'default')}" if (c := choice.get(rt)) else "not chosen")
                          for rt in ("claude", "codex"))
        print(f"{name:<12} workload {core.load_harness(name).get('workload', '?'):<9} {shown}")
    if rest:
        for rt in ("claude", "codex"):
            print(f"\n{rt} models here:")
            for slug, desc in launch.available_models(rt):
                print(f"  {slug:<16} {desc}")
        print("\neffort: " + "; ".join(f"{rt} {' | '.join(e)}" for rt, e in launch.EFFORTS.items()))
    return 0


def cmd_harness(action, name=None):
    names = core.harness_names()
    if action == "list":
        routes = (core.read_json(os.path.join(core.LOCAL, "routes.json"), {}) or {}).get("routes", [])
        off = core.disabled_harnesses()
        rows = []
        for n in names:
            h = core.load_harness(n)
            codex = launch.codex_plugin_problem(n, h.get("version"))
            kinds = ", ".join(r["taskKind"] for r in routes if r.get("harness") == n) or "-"
            rows.append((n, str(h.get("version")), "off" if n in off else "on",
                         "ok" if not codex else ("old" if "old copy" in codex else "missing"),
                         "yes" if h.get("experimental") else "no", kinds, str(h.get("purpose", ""))))
        head = ("HARNESS", "VERSION", "STATE", "CODEX", "EXPERIMENTAL", "ROUTES", "PURPOSE")
        widths = [max(len(r[i]) for r in rows + [head]) for i in range(len(head))]
        for r in [head] + rows:
            print("  ".join(v.ljust(w) for v, w in zip(r, widths)).rstrip())
        return 0
    if name not in names:
        return fail(f"unknown harness {name!r}; known: {', '.join(names)}")
    core.set_harness_enabled(name, action == "on")
    core.log_event("harness", harness=name, enabled=action == "on")
    print(f"yt: harness {name} is {action}" + ("" if action == "on" else " (running sub-sessions are not affected)"))
    return 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0 if argv else 1
    cmd, rest = argv[0], argv[1:]
    try:
        if cmd == "status" and not rest:
            return cmd_status()
        if cmd == "resume" and len(rest) in (1, 3) and (len(rest) == 1 or rest[1] == "--deadline"):
            return cmd_resume(rest[0], rest[2] if len(rest) == 3 else None)
        if cmd == "panel" and rest in ([], ["--no-doctor"], ["--json"]):
            from ytlib import panel
            print(json.dumps(panel.snapshot()) if rest == ["--json"] else panel.render(with_doctor=not rest))
            return 0
        if cmd == "watch":
            from ytlib import watch
            args, interval = list(rest), 15
            if "--interval" in args:
                i = args.index("--interval")
                if i + 1 >= len(args) or not args[i + 1].isdigit() or int(args[i + 1]) < 2:
                    return fail("--interval takes whole seconds, 2 or more")
                interval = int(args.pop(i + 1))
                args.pop(i)
            if not set(args) - {"--once", "--no-notify"}:
                return watch.run(interval, "--once" in args, (lambda _t: None) if "--no-notify" in args else watch.notify)
        if cmd == "metrics" and (not rest or (len(rest) == 2 and rest[0] == "--days" and rest[1].isdigit())):
            return cmd_metrics(int(rest[1]) if rest else 30)
        if cmd == "harness" and rest[:1] == ["new"] and len(rest) == 3:
            try:
                path = lab.harness_new(rest[1], rest[2])
            except ValueError as ex:
                return fail(str(ex))
            print(f"yt: created {path} (experimental). Next: write its skill, add a route in "
                  f"~/yt-local/routes.json, run yt-setup, then spawn with --experimental.")
            return 0
        if cmd == "harness" and rest == ["candidates"]:
            found = lab.candidates()
            for kind, n in found:
                print(f"{kind}: no route, came up {n} times; consider `yt harness new`")
            if not found:
                print("no candidates")
            return 0
        if cmd == "eval" and len(rest) >= 2:
            return cmd_eval(rest[0], rest[1:])
        if cmd == "improve" and len(rest) >= 2 and rest[1] == "--propose":
            return cmd_improve_propose(rest[0], list(rest[2:]))
        if cmd == "improve" and len(rest) == 1:
            return cmd_improve(rest[0])
        if cmd == "card" and len(rest) == 1:
            return cmd_card(rest[0])
        if cmd == "model" and len(rest) in (0, 1, 3, 4):
            return cmd_model(rest)
        if cmd == "harness" and rest[:1] == ["list"] and len(rest) == 1:
            return cmd_harness("list")
        if cmd == "harness" and rest[:1] in (["on"], ["off"]) and len(rest) == 2:
            return cmd_harness(rest[0], rest[1])
        if cmd == "route" and len(rest) <= 1:
            return cmd_route(*rest)
        if cmd == "collect" and len(rest) == 1:
            return cmd_collect(rest[0])
        if cmd == "answer" and len(rest) == 2:
            return cmd_answer(rest[0], rest[1])
        if cmd in ("attach", "stop", "forget", "bring") and len(rest) == 1:
            return {"attach": cmd_attach, "stop": cmd_stop, "forget": cmd_forget, "bring": cmd_bring}[cmd](rest[0])
    except KeyError as e:
        return fail(f"unknown task {e.args[0]}")
    except TimeoutError as e:
        return fail(str(e))
    print(__doc__, file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
