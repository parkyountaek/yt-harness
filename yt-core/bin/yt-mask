#!/usr/bin/env python3
"""Check text for secrets, personal data, and locally blocked terms before it is kept.

Usage:
  yt-mask <file>...          report "<file>:<line>: <kind>" for each finding
  yt-mask --fix <file>...    replace findings with [MASKED:<kind>] in place, then report
  yt-mask -                  check stdin

Findings never include the matched text. Exit codes: 0 clean (or fixed), 1 findings, 2 usage.
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))
from ytlib import mask  # noqa: E402


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0 if argv else 2
    fix = argv[0] == "--fix"
    paths = argv[1:] if fix else argv
    found = 0
    for path in paths:
        text = sys.stdin.read() if path == "-" else open(path, encoding="utf-8", errors="replace").read()
        hits = mask.scan(text)
        if fix and hits and path != "-":
            with open(path, "w", encoding="utf-8") as f:
                f.write(mask.redact(text))
            print(f"{path}: masked {len(hits)} finding(s)")
            continue
        for line, kind in hits:
            print(f"{path}:{line}: {kind}")
        found += len(hits)
    return 1 if found else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
