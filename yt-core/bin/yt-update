#!/usr/bin/env python3
"""Update the yt-harness skeleton safely.

Usage: yt-update [--full]

  1. Refuse while a sub-session is running or starting, or the checkout has local changes
  2. git pull --ff-only (never merges or rewrites local history)
  3. yt-build --check, then the regression tests:
       tests/instructions/run.sh, tests/guard/run.py, tests/contract/run.py, tests/sandbox/run.py
       (--full adds tests/repo-guard/run.sh, which takes a few minutes)
  4. yt-setup (refreshes the Codex copies and the command links)
  5. On any failure: move back to the previous commit (git reset --keep) and rerun yt-setup

Exit codes: 0 updated or already up to date, 1 refused or rolled back.
"""
import os
import subprocess
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))
from ytlib import core  # noqa: E402
from ytlib import runners  # noqa: E402

BIN = os.path.dirname(os.path.realpath(__file__))
REPO = os.path.dirname(os.path.dirname(BIN))
TESTS = [["sh", "tests/instructions/run.sh"], [sys.executable, "tests/guard/run.py"],
         [sys.executable, "tests/contract/run.py"],
         [sys.executable, "tests/sandbox/run.py"]]
FULL = [["sh", "tests/repo-guard/run.sh"]]


def say(status, msg):
    print(f"[{status:>7}] {msg}")


def git(*args):
    return subprocess.run(["git", "-C", REPO, *args], capture_output=True, text=True)


def busy_sessions():
    busy = []
    for task_id, e in core.load_sessions()["sessions"].items():
        alive = bool(e.get("runnerHandle")) and runners.load(e["runner"]).alive(e["runnerHandle"])
        if alive or e.get("starting"):
            busy.append(task_id)
    return sorted(busy)


def checks(full):
    """Return the first failing step, or None."""
    for cmd in [[sys.executable, os.path.join(BIN, "yt-build"), "--check"]] + TESTS + (FULL if full else []):
        r = subprocess.run(cmd, cwd=REPO, capture_output=True, text=True)
        last = ((r.stdout + r.stderr).strip().splitlines() or [""])[-1]
        name = " ".join(os.path.relpath(c, REPO) if c.startswith(REPO) else c for c in cmd[1:]) or cmd[0]
        say("ok" if r.returncode == 0 else "failed", f"{name}: {last}")
        if r.returncode != 0:
            return name
    return None


def setup():
    return subprocess.run([sys.executable, os.path.join(BIN, "yt-setup")], capture_output=True, text=True).returncode


def main(argv):
    if any(a in ("-h", "--help") for a in argv):
        print(__doc__)
        return 0
    full = "--full" in argv
    busy = busy_sessions()
    if busy:
        say("stop", "sub-sessions are running: " + ", ".join(busy) + "; stop them or wait")
        return 1
    if git("status", "--porcelain").stdout.strip():
        say("stop", "the checkout has local changes; commit or stash them first")
        return 1
    old = git("rev-parse", "HEAD").stdout.strip()
    pull = git("pull", "--ff-only")
    if pull.returncode != 0:
        say("stop", "git pull --ff-only failed: " + (pull.stderr.strip().splitlines() or ["?"])[-1])
        return 1
    new = git("rev-parse", "HEAD").stdout.strip()
    if new == old:
        say("ok", f"already up to date ({old[:7]})")
        return 0
    say("info", f"pulled {old[:7]} -> {new[:7]}")
    failed = checks(full)
    if failed is None and setup() == 0:
        core.log_event("update", fromCommit=old[:12], toCommit=new[:12], ok=True)
        say("ok", f"updated to {new[:7]}")
        return 0
    reason = failed or "yt-setup"
    say("back", f"{reason} failed; moving back to {old[:7]}")
    git("reset", "--keep", old)
    setup()
    core.log_event("update", fromCommit=old[:12], toCommit=new[:12], ok=False, failed=reason)
    say("stop", f"update rolled back; {new[:7]} stays fetched for inspection (git log {old[:7]}..{new[:7]})")
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
