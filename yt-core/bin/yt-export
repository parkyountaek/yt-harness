#!/usr/bin/env python3
"""Pack the local layer (~/yt-local/) to move it to another machine without GitHub.

Usage:
  yt-export [<file>] [--data]

  <file>    where to write the archive (default ~/yt-local-export-<date>.tar.gz);
            must be outside the repository and outside ~/yt-local/
  --data    also pack the numeric records (metrics, evals, events)

Packed: config.json (without "repo"), routes.json, active.json, blocked-terms.txt,
blocked-paths.txt. Never packed: the session list, runner state, locks, task folders.
Home paths are written as ~/... The archive holds your blocked terms: keep it off
GitHub and shared drives, and delete it after yt-import on the other machine.
Exit codes: 0 written, 1 error.
"""
import os
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))
from ytlib import transfer  # noqa: E402


def main(argv):
    if "-h" in argv or "--help" in argv:
        print(__doc__)
        return 0
    with_data = "--data" in argv
    rest = [a for a in argv if a != "--data"]
    if len(rest) > 1 or any(a.startswith("-") for a in rest):
        print(__doc__, file=sys.stderr)
        return 1
    dest = rest[0] if rest else os.path.join("~", f"yt-local-export-{time.strftime('%Y%m%d')}.tar.gz")
    try:
        names = transfer.export(dest, with_data)
    except (OSError, ValueError) as e:
        print(f"yt-export: {e}", file=sys.stderr)
        return 1
    print(f"yt-export: wrote {os.path.expanduser(dest)} ({', '.join(names) or 'nothing to pack'})")
    print("yt-export: it holds your blocked terms; move it by hand, then run yt-import there and delete it")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
