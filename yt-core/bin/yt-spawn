#!/usr/bin/env python3
"""Start a harnessed sub-session for one task.

Usage:
  yt-spawn <task-id> <harness> [--runtime claude|codex] [--runner tmux]
           [--deadline 30m|2h|<ISO 8601>] [--brief <file>]

Task folder: ~/yt-work/<task-id>/
  in/        inputs prepared by the human (read-only to the session)
  out/       session working directory: result.md, status.json (writable); must start empty
  tmp/       per-task temp dir (TMPDIR)
  TASK.md    work order generated here; identical for every runtime

The brief (goal, constraints, done criteria) comes from --brief, or from
in/BRIEF.md when --brief is omitted.

Exit codes: 0 started, 1 duplicate task id, bad input, or start failure, 2 concurrency limit reached.
"""
import argparse
import os
import shutil
import sys
import uuid

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))
from ytlib import core  # noqa: E402
from ytlib import launch  # noqa: E402
from ytlib import platform as ytplatform  # noqa: E402
from ytlib import runners  # noqa: E402

TASK_TEMPLATE = """# Work order: {task_id}

You are a sub-session started by the yt-harness coordinator. You do not see the
coordinator's conversation; everything you need is in this file.

- Harness: {harness} {version} ({purpose})
- Task folder: {task_dir}
- Inputs (read-only): {task_dir}/in/
- Your working directory (writable): {task_dir}/out/
- Deadline: {deadline}

## Rules

1. Report state only with the `yt-status` command. Never edit `status.json` yourself.
2. When you need a human decision, run `yt-status waiting-human --question "<one sentence>"`,
   then stop and wait for the human's reply in this session. After the reply, run `yt-status running`.
3. Write the final answer to `{task_dir}/out/result.md`. Overwrite the file; never append.
4. Only after result.md is written, run `yt-status done`.
5. If you cannot finish, run `yt-status failed --reason "<one sentence>"`.
6. Do not try to read or write outside the task folder. The sandbox blocks it; do not work around it.

## Brief

{brief}
"""

STARTING_TIMEOUT = 120  # seconds; a reservation older than this no longer holds a slot


def fail(msg, code=1):
    print(f"yt-spawn: {msg}", file=sys.stderr)
    return code


def holds_slot(entry):
    if entry.get("starting"):
        started = core.safe_deadline(entry.get("startedAt"))
        return started is not None and (core.now() - started).total_seconds() < STARTING_TIMEOUT
    return bool(entry.get("runnerHandle")) and runners.load(entry["runner"]).alive(entry["runnerHandle"])


def main(argv):
    ap = argparse.ArgumentParser(prog="yt-spawn")
    ap.add_argument("task_id")
    ap.add_argument("harness")
    ap.add_argument("--runtime", choices=("claude", "codex"), default="claude")
    ap.add_argument("--runner", default=runners.DEFAULT)
    ap.add_argument("--deadline")
    ap.add_argument("--brief")
    args = ap.parse_args(argv)

    if not core.TASK_ID.match(args.task_id):
        return fail("task id must be lowercase letters, digits, and dashes")
    if not shutil.which(args.runtime):
        return fail(f"runtime {args.runtime} is not installed")
    try:
        harness = core.load_harness(args.harness)
        ytplatform.load()
        runners.load(args.runner)
    except (OSError, ValueError, ImportError, ytplatform.UnsupportedPlatform) as e:
        return fail(str(e))
    if harness.get("folderKind") != "neutral":
        return fail(f"folderKind {harness.get('folderKind')!r} is not implemented yet (only neutral)")
    if args.runtime == "codex":
        problem = launch.codex_plugin_problem(args.harness, harness.get("version"))
        if problem:
            return fail(problem)

    task_dir = core.task_dir(args.task_id)
    in_dir, out_dir = os.path.join(task_dir, "in"), os.path.join(task_dir, "out")
    brief_path = args.brief or os.path.join(in_dir, "BRIEF.md")
    try:
        with open(brief_path, encoding="utf-8") as f:
            brief = f.read().strip()
    except OSError:
        return fail(f"no brief: pass --brief <file> or create {brief_path}")
    start = core.now()
    try:
        deadline = core.parse_deadline(args.deadline or harness.get("deadlineDefault") or "2h", start)
    except ValueError:
        return fail(f"bad deadline {args.deadline!r}; use 30m, 2h, 1d, or ISO 8601")
    session_id = str(uuid.uuid4()) if args.runtime == "claude" else None

    # Reserve the task id and a slot under the registry lock.
    with core.locked(core.REGISTRY_LOCK):
        reg = core.load_sessions()
        sessions = reg["sessions"]
        if args.task_id in sessions:
            return fail(f"task {args.task_id} was already started; use `yt resume` or `yt forget` first")
        leftovers = [n for n in os.listdir(out_dir) if not n.startswith(".")] if os.path.isdir(out_dir) else []
        if leftovers:
            return fail(f"{out_dir} is not empty ({', '.join(sorted(leftovers)[:3])}); "
                        "move or delete the old results first")
        busy = sum(holds_slot(e) for e in sessions.values())
        if busy >= core.MAX_CONCURRENT:
            return fail(f"{busy} sub-sessions running; the limit is {core.MAX_CONCURRENT}", 2)

        os.makedirs(in_dir, exist_ok=True)
        os.makedirs(out_dir, exist_ok=True)
        with open(os.path.join(task_dir, "TASK.md"), "w", encoding="utf-8") as f:
            f.write(TASK_TEMPLATE.format(task_id=args.task_id, harness=args.harness,
                                         version=harness.get("version"), purpose=harness.get("purpose"),
                                         task_dir=task_dir, deadline=core.iso(deadline), brief=brief))
        core.write_status(task_dir, {
            "schema": 1, "taskId": args.task_id,
            "runner": args.runner, "runnerHandle": None,
            "runtime": args.runtime, "runtimeSessionId": session_id,
            "harness": args.harness, "harnessVersion": harness.get("version"),
            "folder": task_dir, "state": "running", "deadline": core.iso(deadline),
        })
        sessions[args.task_id] = {"taskId": args.task_id, "harness": args.harness, "runtime": args.runtime,
                                  "runner": args.runner, "runnerHandle": None, "runtimeSessionId": session_id,
                                  "deadline": core.iso(deadline), "startedAt": core.iso(start), "starting": True}
        core.save_sessions(reg)

    # Start outside the lock: finding the Codex session id can take a while.
    error = None
    handle = None
    try:
        handle, session_id = launch.start(args.task_id, args.harness, harness, args.runtime,
                                          args.runner, session_id)
    except Exception as e:  # noqa: BLE001  any start failure must end in a recorded state
        error = str(e) or e.__class__.__name__

    with core.locked(core.REGISTRY_LOCK):
        reg = core.load_sessions()
        entry = reg["sessions"][args.task_id]
        entry.update(runnerHandle=handle, runtimeSessionId=session_id, starting=False)
        core.save_sessions(reg)

    def record(status):
        status.update(runnerHandle=handle, runtimeSessionId=session_id)
        if error:
            status.update(state="failed", reason=f"start failed: {error}")

    core.update_status(task_dir, record)
    core.log_event("spawn", taskId=args.task_id, harness=args.harness, harnessVersion=harness.get("version"),
                   runtime=args.runtime, runner=args.runner, ok=error is None)
    if error:
        return fail(f"start failed: {error}")
    print(f"yt-spawn: started {args.task_id} ({args.harness}, {args.runtime}, {args.runner} handle {handle})")
    if session_id is None:
        print("yt-spawn: warning: Codex session id not found yet; `yt resume` will look again",
              file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
