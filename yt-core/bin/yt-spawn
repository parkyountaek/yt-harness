#!/usr/bin/env python3
"""Start a harnessed sub-session for one task.

Usage:
  yt-spawn <task-id> <harness> [--runtime claude|codex] [--runner tmux|headless|orca] [--experimental]
           [--deadline 30m|2h|<ISO 8601>] [--brief <file>] [--vault <name>] [--repo <name>]
           [--model <name>] [--effort low|medium|high|xhigh|max]

Task folder: ~/yt-work/<task-id>/
  in/        inputs prepared by the human (read-only to the session)
  out/       session working directory: result.md, status.json (writable); must start empty
  tmp/       per-task temp dir (TMPDIR)
  TASK.md    work order generated here; identical for every runtime

The brief (goal, constraints, done criteria) comes from --brief, or from
in/BRIEF.md when --brief is omitted. A folderKind: repo or worktree harness needs
--repo <name>, one of "repos" in ~/yt-local/config.json: the session works on a
private clone in <task folder>/repo (worktree: on branch yt/<task id>, brought back
with `yt bring`), never on the repository itself. A folderKind: vault harness also needs
--vault <name>, one of "vaults" in ~/yt-local/config.json; the session may read
and write inside that folder. A vault that is a git repository is never written
directly: the session gets a private clone on branch yt/<task id>, like worktree.

Model and effort come from the human's choice for the harness and runtime in this
workspace, the project yt-spawn runs in (`yt model`),
made once from the harness's workload; --model/--effort change them for one task only.
`yt resume` keeps the task's choice.

Exit codes: 0 started, 1 duplicate task id, bad input, or start failure, 2 concurrency limit reached.
"""
import argparse
import os
import shutil
import sys
import uuid

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))
from ytlib import core  # noqa: E402
from ytlib import gitwork  # noqa: E402
from ytlib import launch  # noqa: E402
from ytlib import parity  # noqa: E402
from ytlib import platform as ytplatform  # noqa: E402
from ytlib import runners  # noqa: E402

TASK_TEMPLATE = """# Work order: {task_id}

You are a sub-session started by the yt-harness coordinator. You do not see the
coordinator's conversation; everything you need is in this file.

- Harness: {harness} {version} ({purpose})
- Task folder: {task_dir}
- Inputs (read-only): {task_dir}/in/
- Your working directory (writable): {task_dir}/out/
{vault_line}- Deadline: {deadline}

## Rules

1. Report state only with `yt-status`; never edit `status.json`.
2. If the brief leaves open a choice that changes the result, run
   `yt-status waiting-human --question "<one sentence>"` and wait. After the reply, `yt-status running`.
3. Write the final answer to `{task_dir}/out/result.md` (overwrite), then run `yt-status done`.
   If you cannot finish, run `yt-status failed --reason "<one sentence>"`.
4. The sandbox limits you to the task folder and the folders listed above; do not work around it.
5. Where your user-level instructions conflict with this work order, the work order wins.
6. Write result.md and your questions in the language of the brief unless it says otherwise.

## Brief

{brief}
"""

STARTING_TIMEOUT = 120  # seconds; a reservation older than this no longer holds a slot


def folder_line(vault, source, kind, task_dir, task_id):
    """The work order's line for a vault or a repository clone; identical for every runtime."""
    if vault and source:
        return (f"- Vault (your private clone of {source}, branch {gitwork.BRANCH.format(task_id=task_id)}; "
                f"read and write): {vault}\n"
                "- Commit your notes on that branch; never push. `yt bring` hands the branch to the human.\n")
    if vault:
        return f"- Vault (read and write): {vault}\n"
    if not source:
        return ""
    clone = os.path.join(task_dir, gitwork.CLONE)
    if kind == "repo":
        return (f"- Repository (read-only private clone of {source}): {clone}\n"
                "- Follow the repository's own contributor rules (AGENTS.md, CLAUDE.md, README) as part of this order.\n")
    return (f"- Repository (your private clone of {source}, branch {gitwork.BRANCH.format(task_id=task_id)}): {clone}\n"
            "- Make the change in the clone and commit it on that branch; never push. Follow the repository's own\n"
            "  contributor rules (AGENTS.md, CLAUDE.md, README) as part of this order.\n")


def fail(msg, code=1):
    print(f"yt-spawn: {msg}", file=sys.stderr)
    return code


def holds_slot(entry):
    if entry.get("starting"):
        started = core.safe_deadline(entry.get("startedAt"))
        return started is not None and (core.now() - started).total_seconds() < STARTING_TIMEOUT
    return bool(entry.get("runnerHandle")) and runners.load(entry["runner"]).alive(entry["runnerHandle"])


def main(argv):
    ap = argparse.ArgumentParser(prog="yt-spawn")
    ap.add_argument("task_id")
    ap.add_argument("harness")
    ap.add_argument("--runtime", choices=("claude", "codex"), default="claude")
    ap.add_argument("--runner", default=runners.DEFAULT)
    ap.add_argument("--deadline")
    ap.add_argument("--brief")
    ap.add_argument("--vault", help="vault name for folderKind: vault harnesses")
    ap.add_argument("--repo", help="repository name for folderKind: repo or worktree harnesses")
    # Paths a worktree branch may change; set by `yt improve --propose`, enforced by collect and bring.
    ap.add_argument("--scope", action="append", help=argparse.SUPPRESS)
    ap.add_argument("--model", help="model for this task (default: the harness's model for the runtime)")
    ap.add_argument("--effort", help="effort for this task (default: the harness's effort)")
    ap.add_argument("--experimental", action="store_true", help="allow a harness marked experimental: true")
    args = ap.parse_args(argv)

    if not core.TASK_ID.match(args.task_id):
        return fail("task id must be lowercase letters, digits, and dashes")
    if not shutil.which(args.runtime):
        return fail(f"runtime {args.runtime} is not installed")
    try:
        harness = core.load_harness(args.harness)
        plat = ytplatform.load()
        runners.load(args.runner)
    except (OSError, ValueError, ImportError, ytplatform.UnsupportedPlatform) as e:
        return fail(str(e))
    if plat.sandbox_problem():
        return fail(plat.sandbox_problem())
    drift = parity.problems()
    if drift:
        return fail("Claude and Codex global setup differ, so their sub-sessions would not match:\n  "
                    + "\n  ".join(drift) + "\nFix the files, then retry (yt-setup --check shows this too).")
    if harness.get("experimental") and not args.experimental:
        return fail(f"harness {args.harness} is experimental; pass --experimental to use it for this task")
    passed = harness.get("runtimes") or []
    if passed and args.runtime not in passed and not args.experimental:
        return fail(f"harness {args.harness} has passed its live tests on {', '.join(passed)} only; "
                    f"pass --experimental to try it on {args.runtime}")
    if args.harness in core.disabled_harnesses():
        return fail(f"harness {args.harness} is turned off; `yt harness on {args.harness}` to use it")
    try:
        model, effort = launch.pick_model(args.harness, args.runtime, args.model, args.effort)
    except ValueError as e:
        return fail(str(e))
    vault = source = None
    kind = harness.get("folderKind")
    if args.repo and kind not in ("repo", "worktree"):
        return fail(f"harness {args.harness} does not use a repository")
    if args.scope and kind != "worktree":
        return fail("--scope applies to worktree harnesses only")
    if kind in ("repo", "worktree"):
        known_repos = gitwork.repos()
        if args.repo not in known_repos:
            return fail(f"harness {args.harness} needs --repo <name>; known: {', '.join(known_repos) or 'none'} "
                        "(add one under \"repos\" in ~/yt-local/config.json)")
        source = known_repos[args.repo]
        problem = gitwork.source_problem(source)
        if problem:
            return fail(problem)
    elif kind == "vault":
        known = core.vaults()
        if args.vault not in known:
            return fail(f"harness {args.harness} needs --vault <name>; known: {', '.join(known) or 'none'} "
                        "(add one under \"vaults\" in ~/yt-local/config.json)")
        vault = known[args.vault]
        if not (os.path.isdir(vault) and vault.startswith(core.HOME + "/")) or core.REPO.startswith(vault + "/"):
            return fail(f"vault {vault} must be an existing folder inside $HOME and must not contain the repo")
        problem, top = gitwork.vault_problem(vault)
        if problem:
            return fail(problem)
        if top:
            # A git vault: the session works on a private clone, never on the vault itself.
            source, vault = vault, os.path.join(core.task_dir(args.task_id), gitwork.CLONE)
    elif kind != "neutral":
        return fail(f"folderKind {kind!r} is not implemented (neutral, vault, repo, worktree)")
    if args.vault and kind != "vault":
        return fail(f"harness {args.harness} does not use a vault")
    if args.runtime == "codex":
        problem = launch.codex_plugin_problem(args.harness, harness.get("version"))
        if problem:
            return fail(problem)

    task_dir = core.task_dir(args.task_id)
    in_dir, out_dir = os.path.join(task_dir, "in"), os.path.join(task_dir, "out")
    brief_path = args.brief or os.path.join(in_dir, "BRIEF.md")
    try:
        with open(brief_path, encoding="utf-8") as f:
            brief = f.read().strip()
    except OSError:
        return fail(f"no brief: pass --brief <file> or create {brief_path}")
    start = core.now()
    try:
        deadline = core.parse_deadline(args.deadline or harness.get("deadlineDefault") or "2h", start)
    except ValueError:
        return fail(f"bad deadline {args.deadline!r}; use 30m, 2h, 1d, or ISO 8601")
    session_id = str(uuid.uuid4()) if args.runtime == "claude" else None

    # Reserve the task id and a slot under the registry lock.
    with core.locked(core.REGISTRY_LOCK):
        reg = core.load_sessions()
        sessions = reg["sessions"]
        if args.task_id in sessions:
            return fail(f"task {args.task_id} was already started; use `yt resume` or `yt forget` first")
        leftovers = [n for n in os.listdir(out_dir) if not n.startswith(".")] if os.path.isdir(out_dir) else []
        if leftovers:
            return fail(f"{out_dir} is not empty ({', '.join(sorted(leftovers)[:3])}); "
                        "move or delete the old results first")
        busy = sum(holds_slot(e) for e in sessions.values())
        if busy >= core.MAX_CONCURRENT:
            return fail(f"{busy} sub-sessions running; the limit is {core.MAX_CONCURRENT}", 2)

        os.makedirs(in_dir, exist_ok=True)
        os.makedirs(out_dir, exist_ok=True)
        with open(os.path.join(task_dir, "TASK.md"), "w", encoding="utf-8") as f:
            f.write(TASK_TEMPLATE.format(task_id=args.task_id, harness=args.harness,
                                         version=harness.get("version"), purpose=harness.get("purpose"),
                                         task_dir=task_dir, deadline=core.iso(deadline), brief=brief,
                                         vault_line=folder_line(vault, source, kind, task_dir, args.task_id)))
        core.write_status(task_dir, {
            "schema": 1, "taskId": args.task_id,
            "runner": args.runner, "runnerHandle": None,
            "runtime": args.runtime, "runtimeSessionId": session_id,
            "harness": args.harness, "harnessVersion": harness.get("version"),
            "folder": task_dir, "state": "running", "deadline": core.iso(deadline),
        })
        sessions[args.task_id] = {"taskId": args.task_id, "harness": args.harness, "runtime": args.runtime,
                                  "runner": args.runner, "runnerHandle": None, "runtimeSessionId": session_id,
                                  "deadline": core.iso(deadline), "startedAt": core.iso(start), "starting": True,
                                  **({"vault": args.vault, "vaultPath": vault} if vault else {}),
                                  **({"repo": args.repo} if args.repo else {}),
                                  **({"model": model} if model else {}), **({"effort": effort} if effort else {})}
        core.save_sessions(reg)

    # The clone is made outside the lock (a large repository takes a while).
    error = None
    repo = {}
    if source:
        try:
            repo = gitwork.prepare(args.task_id, source, writable=kind in ("worktree", "vault"), scope=args.scope)
            if kind == "vault":
                gitwork.copy_vault_settings(source, repo["repoClone"])
        except Exception as e:  # noqa: BLE001  a failed clone must end in a recorded state
            error = f"clone failed: {e}"
        with core.locked(core.REGISTRY_LOCK):
            reg = core.load_sessions()
            reg["sessions"][args.task_id].update(repo)
            core.save_sessions(reg)

    # Start outside the lock: finding the Codex session id can take a while.
    handle = None
    if not error:
        try:
            handle, session_id = launch.start(args.task_id, args.harness, harness, args.runtime,
                                              args.runner, session_id, vault=vault, repo_source=repo.get("repoSource"),
                                              repo_clone=repo.get("repoClone"), model=model, effort=effort)
        except Exception as e:  # noqa: BLE001  any start failure must end in a recorded state
            error = str(e) or e.__class__.__name__

    with core.locked(core.REGISTRY_LOCK):
        reg = core.load_sessions()
        entry = reg["sessions"][args.task_id]
        entry.update(runnerHandle=handle, runtimeSessionId=session_id, starting=False)
        core.save_sessions(reg)

    def record(status):
        status.update(runnerHandle=handle, runtimeSessionId=session_id)
        if error:
            status.update(state="failed", reason=f"start failed: {error}")

    core.update_status(task_dir, record)
    core.log_event("spawn", taskId=args.task_id, harness=args.harness, harnessVersion=harness.get("version"),
                   runtime=args.runtime, runner=args.runner, model=model, effort=effort, ok=error is None)
    if error:
        return fail(f"start failed: {error}")
    print(f"yt-spawn: started {args.task_id} ({args.harness}, {args.runtime}, {args.runner} handle {handle})")
    if model or effort:
        print(f"yt-spawn: model {model or 'runtime default'}, effort {effort or 'runtime default'}")
    else:
        print(f"yt-spawn: no model chosen for {args.harness} on {args.runtime} yet (runtime default used); "
              f"see `yt model {args.harness}`")
    if session_id is None:
        print("yt-spawn: warning: Codex session id not found yet; `yt resume` will look again",
              file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
